  prov:wasAttributedTo <https://w3id.org/ripe/ripe-kg/source/pubpeer>;
  prov:wasGeneratedBy <https://w3id.org/ripe/ripe-kg/evidence-aggregation/RIPEA4A841AC6ADD4DA5B>;
