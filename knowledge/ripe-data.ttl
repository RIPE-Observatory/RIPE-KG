  prov:wasAttributedTo <https://w3id.org/ripe/ripe-kg/source/pubpeer>;
  prov:wasGeneratedBy <https://w3id.org/ripe/ripe-kg/evidence-aggregation/RIPEAF7E1928294A86E83>;
  prov:wasMemberOf <https://w3id.org/ripe/ripe-kg/research-integrity-assessment/RIPEAF7E1928294A86E83>;
  schema:text "There are many concerns about the integrity of 172 publications by this research group, including this one. Some of the concerns are published 1. Anaesthesia 2020;75:1683–92, see Supplementary data. This paper is A77 2. Account Res 2020;28:149-61. 3. J Clin Epidemiol 2021;131:22-29. Journals and publishers were notified of these concerns in July 2019. 23 publications have an expression of concern. To our knowledge there has been no public response about any of the concerns. We think these publications are unreliable";
  ripe:concerns <https://w3id.org/ripe/ripe-kg/work/10.1016%2Fj.jacl.2015.12.017>;
  tido:supports <https://w3id.org/ripe/ripe-kg/integrity-assessment-hypothesis/RIPEAF7E1928294A86E83-human-1-2>,
