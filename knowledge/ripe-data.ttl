  dc:date "May 2021";
  fabio:hasURL "https://pubpeer.com/publications/473737BEFA1E6B814531F7CEF8D3BB"^^xsd:anyURI;
  prov:wasAttributedTo <https://w3id.org/ripe/ripe-kg/source/pubpeer>;
