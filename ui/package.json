{
  "name": "ripe-knowledge-graph-ui",
  "version": "1.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run build:worker && next dev",
    "build": "bun run build:worker && next build",
    "start": "node .next/standalone/server.js",
    "lint": "find src -type f \\( -name '*.ts' -o -name '*.tsx' \\) -print0 | xargs -0 oxlint",
    "type": "tsc --noEmit",
    "check": "bun run lint && bun run type",
    "test": "bun test tests",
    "build:worker": "bun build node_modules/monaco-editor/esm/vs/editor/editor.worker.js --target=browser --minify --outfile=public/vendor/monaco/editor.worker.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@traqula/parser-sparql-1-1": "1.2.1",
    "clsx": "^2.1.1",
    "monaco-editor": "0.56.0",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.58.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "dompurify": "3.4.14"
  }
}
